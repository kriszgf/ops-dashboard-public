WEBHOOK_URL=
WEBHOOK_KEY=
OBSIDIAN_VAULT=
# Vite exposes only VITE_-prefixed vars to the browser:
VITE_OBSIDIAN_VAULT=
VITE_OBSIDIAN_HOST=
VITE_OBSIDIAN_SOURCE=
# tools/vault-read (read-only Obsidian CLI). Real values go only in a git-ignored .env:
VAULT_PATH="/path/to/your/vault"
# Optional extra excludes, comma-separated:
VAULT_EXCLUDE=
# Write mode (v1.6.0) uses the same VAULT_PATH; writes are logged in <vault>/_bot-writes/. No extra settings required.
# Write kill-switch (v1.6.1): writes are refused unless set to 1.
VAULT_WRITE_ENABLED=0
